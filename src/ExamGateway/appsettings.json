{
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Key": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/swagger/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/auth" } ]
      },
      "catalog-swagger": {
        "ClusterId": "catalog",
        "Match": { "Path": "/swagger/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/catalog" } ]
      },
      "orders-swagger": {
        "ClusterId": "orders",
        "Match": { "Path": "/swagger/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/orders" } ]
      },
      "registration-swagger": {
        "ClusterId": "registration",
        "Match": { "Path": "/swagger/registration/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/registration" } ]
      },
      "student-swagger": {
        "ClusterId": "student",
        "Match": { "Path": "/swagger/student/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/student" } ]
      },
      "school-swagger": {
        "ClusterId": "school",
        "Match": { "Path": "/swagger/school/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/school" } ]
      },
      "auth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "catalog-read-route": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "CatalogRead",
        "Match": { "Path": "/api/catalog/subjects/{**catch-all}", "Methods": [ "GET" ] }
      },
      "catalog-write-route": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "CatalogManage",
        "Match": { "Path": "/api/catalog/subjects/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "orders-route": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "registration-read-route": {
        "ClusterId": "registration",
        "AuthorizationPolicy": "RegistrationsRead",
        "Match": { "Path": "/api/registrations/{**catch-all}", "Methods": [ "GET" ] }
      },
      "registration-create-route": {
        "ClusterId": "registration",
        "AuthorizationPolicy": "RegistrationsCreate",
        "Match": { "Path": "/api/registrations/{**catch-all}", "Methods": [ "POST" ] }
      },
      "student-create-route": {
        "ClusterId": "student",
        "AuthorizsationPolicy": "StudentCreate",
        "Match": { "Path": "/api/students/{**catch-all}", "Methods": [ "POST" ] }
      },
      "student-route": {
        "ClusterId": "student",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/students/{**catch-all}" }
      },
      "school-route": {
        "ClusterId": "school",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/schools/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "destination1": { "Address": "" } } },
      "catalog": { "Destinations": { "destination1": { "Address": "" } } },
      "orders": { "Destinations": { "destination1": { "Address": "" } } },
      "registration": { "Destinations": { "destination1": { "Address": "" } } },
      "student": { "Destinations": { "destination1": { "Address": "" } } },
      "school": { "Destinations": { "destination1": { "Address": "" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
