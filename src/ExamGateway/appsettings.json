{
  "Jwt": {
    "Issuer": "Waec.Auth",
    "Audience": "Waec.Api",
    "Key": "local-only-change-this-development-key-before-deployment-2026"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/swagger/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/auth" } ]
      },
      "catalog-swagger": {
        "ClusterId": "catalog",
        "Match": { "Path": "/swagger/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/catalog" } ]
      },
      "orders-swagger": {
        "ClusterId": "orders",
        "Match": { "Path": "/swagger/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/orders" } ]
      },
      "registration-swagger": {
        "ClusterId": "registration",
        "Match": { "Path": "/swagger/registration/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/registration" } ]
      },
      "auth-route": { "ClusterId": "auth", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "catalog-read-route": { "ClusterId": "catalog", "AuthorizationPolicy": "CatalogRead", "Match": { "Path": "/api/catalog/subjects/{**catch-all}", "Methods": [ "GET" ] } },
      "catalog-write-route": { "ClusterId": "catalog", "AuthorizationPolicy": "CatalogManage", "Match": { "Path": "/api/catalog/subjects/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] } },
      "orders-route": { "ClusterId": "orders", "AuthorizationPolicy": "Authenticated", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "registration-read-route": { "ClusterId": "registration", "AuthorizationPolicy": "RegistrationsRead", "Match": { "Path": "/api/registrations/{**catch-all}", "Methods": [ "GET" ] } },
      "registration-create-route": { "ClusterId": "registration", "AuthorizationPolicy": "RegistrationsCreate", "Match": { "Path": "/api/registrations/{**catch-all}", "Methods": [ "POST" ] } }
    },
    "Clusters": {
      "auth": { "Destinations": { "destination1": { "Address": "http://localhost:8084/" } } },
      "catalog": { "Destinations": { "destination1": { "Address": "http://localhost:8081/" } } },
      "orders": { "Destinations": { "destination1": { "Address": "http://localhost:8082/" } } },
      "registration": { "Destinations": { "destination1": { "Address": "http://localhost:8083/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
